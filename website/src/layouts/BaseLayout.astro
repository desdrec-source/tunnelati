---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Independent high-signal coverage of The Boring Company" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Tunnelati</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} | Tunnelati`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo">Tunnel<span>ati</span></a>
        <nav class="nav">
          <a href="/">Home</a>
          <a href="/archive">Archive</a>
          <a href="/sections">Sections</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>

    <main class="container" style="flex: 1;">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>Tunnelati is an independent site operated by XenMedia Marketing Limited. Not affiliated with The Boring Company, xAI, or Elon Musk.</p>
        <p style="margin-top: 0.5rem;">
          <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href="/rss.xml">RSS</a>
        </p>
      </div>
    </footer>
  </body>
</html>
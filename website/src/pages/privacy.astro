---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Privacy" description="Privacy policy for Tunnelati.">
  <h1 class="section-title" style="margin-top: 2rem;">Privacy Policy</h1>
  <div class="article-body" style="margin-top: 1.5rem;">
    <p>Tunnelati does not use cookies for tracking, does not collect personal data, and does not run third-party analytics that identify individual visitors.</p>
    <p>Standard server logs may temporarily record IP addresses for security and performance. These are not used for marketing.</p>
    <p>If you contact us by email, we will use your address only to reply.</p>
    <p>Operator: XenMedia Marketing Limited, Peterborough, UK. Contact: info@xenmediamarketing.co.uk</p>
  </div>
</BaseLayout>
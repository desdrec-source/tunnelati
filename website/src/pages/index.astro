---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allArticles = await getCollection("articles");
const now = new Date();
const thirtyDaysAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);

const recent = allArticles
  .filter(a => a.data.pubDate >= thirtyDaysAgo)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = recent.find(a => a.data.featured) || recent[0];
const others = recent.filter(a => a.id !== featured?.id);

const byCategory = {};
for (const a of others) {
  const cat = a.data.category;
  if (!byCategory[cat]) byCategory[cat] = [];
  byCategory[cat].push(a);
}

const catSlug = {
  "Vegas Loop": "vegas",
  "Nashville": "nashville",
  "Machines": "machines",
  "Projects": "projects",
  "Company": "company",
};
---
<BaseLayout title="Home" description="Independent high-signal coverage of official The Boring Company developments.">
  <div class="main">
    <div class="home-hero">
      <span class="home-kicker">The Boring Company news</span>
      <h1 class="page-title">Latest updates</h1>
      <p class="page-subtitle">Focused coverage of official announcements and high-signal developments.</p>
    </div>

    {featured && (
      <section class="featured-section">
        <div class="featured-label">Featured</div>
        <a href={`/articles/${featured.id}`} class="featured-card">
          <div class="featured-meta">
            <span>{featured.data.pubDate.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })}</span>
            <span class="featured-cat">{featured.data.category}</span>
          </div>
          <h2 class="featured-title">{featured.data.title}</h2>
          <p class="featured-desc">{featured.data.description}</p>
          {featured.data.sourceName && (
            <p class="featured-source">Source: {featured.data.sourceName}</p>
          )}
        </a>
      </section>
    )}

    {Object.entries(byCategory).map(([cat, items]) => (
      <section class={`category-section cat-${catSlug[cat] || "vegas"}`}>
        <div class="category-header">
          <h2 class="category-title">{cat}</h2>
        </div>
        <div class="articles-grid">
          {items.map(a => (
            <article class="article-card">
              <a href={`/articles/${a.id}`}>
                <div class="card-meta-row">
                  <span class={`card-category cat-${catSlug[a.data.category] || "vegas"}`}>{a.data.category}</span>
                  <span class="card-date">{a.data.pubDate.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })}</span>
                </div>
                <h3 class="card-title">{a.data.title}</h3>
                <p class="card-desc">{a.data.description}</p>
                {a.data.sourceName && <p class="card-source">Source: {a.data.sourceName}</p>}
              </a>
            </article>
          ))}
        </div>
      </section>
    ))}

    {recent.length === 0 && (
      <p class="muted">No articles in the last 30 days yet.</p>
    )}
  </div>
</BaseLayout>
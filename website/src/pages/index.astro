---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allArticles = await getCollection("articles");
const now = new Date();
const thirtyDaysAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);

const recent = allArticles
  .filter(a => a.data.pubDate >= thirtyDaysAgo)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = recent.find(a => a.data.featured) || recent[0];
const others = recent.filter(a => a.id !== featured?.id);

const byCategory = {};
for (const a of others) {
  const cat = a.data.category;
  if (!byCategory[cat]) byCategory[cat] = [];
  byCategory[cat].push(a);
}
---
<BaseLayout title="Home" description="Independent high-signal coverage of official The Boring Company developments.">
  <h1 class="section-title" style="margin-top: 2rem;">Latest</h1>
  <p class="muted">Official sources only. Last 30 days.</p>

  {featured && (
    <div class="card featured" style="margin-top: 1.5rem;">
      <span class="card-category">{featured.data.category}</span>
      <h2><a href={`/articles/${featured.id}`}>{featured.data.title}</a></h2>
      <p>{featured.data.description}</p>
      <div class="card-meta">
        {featured.data.pubDate.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })}
        {featured.data.sourceName && ` · ${featured.data.sourceName}`}
      </div>
    </div>
  )}

  {Object.keys(byCategory).length > 0 && (
    <>
      {Object.entries(byCategory).map(([cat, items]) => (
        <div>
          <h2 class="section-title">{cat}</h2>
          <div class="card-grid">
            {items.map(a => (
              <article class="card">
                <span class="card-category">{a.data.category}</span>
                <h2><a href={`/articles/${a.id}`}>{a.data.title}</a></h2>
                <p>{a.data.description}</p>
                <div class="card-meta">
                  {a.data.pubDate.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })}
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </>
  )}

  {recent.length === 0 && (
    <p style="margin-top: 2rem;" class="muted">No articles in the last 30 days yet.</p>
  )}
</BaseLayout>

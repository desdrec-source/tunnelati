---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allArticles = await getCollection("articles");
const now = new Date();
const thirtyDaysAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);

const older = allArticles
  .filter(a => a.data.pubDate < thirtyDaysAgo)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const byMonth = {};
for (const a of older) {
  const key = a.data.pubDate.toLocaleDateString("en-GB", { month: "long", year: "numeric" });
  if (!byMonth[key]) byMonth[key] = [];
  byMonth[key].push(a);
}
---
<BaseLayout title="Archive" description="Older Tunnelati articles grouped by month.">
  <h1 class="section-title" style="margin-top: 2rem;">Archive</h1>
  <p class="muted">Articles older than 30 days.</p>

  {Object.keys(byMonth).length === 0 && (
    <p style="margin-top: 2rem;" class="muted">No older articles yet.</p>
  )}

  {Object.entries(byMonth).map(([month, items]) => (
    <div>
      <h2 class="section-title">{month}</h2>
      <div class="card-grid">
        {items.map(a => (
          <article class="card">
            <span class="card-category">{a.data.category}</span>
            <h2><a href={`/articles/${a.id}`}>{a.data.title}</a></h2>
            <p>{a.data.description}</p>
            <div class="card-meta">
              {a.data.pubDate.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })}
            </div>
          </article>
        ))}
      </div>
    </div>
  ))}
</BaseLayout>
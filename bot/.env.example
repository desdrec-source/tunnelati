# ============================================
# Tunnelati Bot — Environment Configuration
# Copy this file to .env and fill in real values
# ============================================

# --- Mode ---
# dry-run is the safe default. Set to "true" only when you are ready
# for the bot to write into the website content folder.
LIVE_MODE=false

# --- X (Twitter) API v2 ---
X_BEARER_TOKEN=your_x_bearer_token_here

# --- xAI / Grok API ---
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4-latest

# --- Monitoring settings ---
# Official accounts to watch (comma-separated, without @)
WATCH_ACCOUNTS=boringcompany
# Also watch Elon but only keep posts that mention Loop / Prufrock / TBC keywords
WATCH_ELON=true

# Keywords that raise signal (used for filtering)
HIGH_SIGNAL_KEYWORDS=Loop,Vegas Loop,Music City Loop,Prufrock,Boring Company,The Boring Company,tunnel,tunnels,station,stations

# How many recent posts to fetch per account
POSTS_PER_ACCOUNT=10

# --- Paths ---
OUTPUT_DIR=output
WEBSITE_ARTICLES_DIR=../website/src/content/articles

# --- Logging ---
LOG_LEVEL=INFO
